{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aboom Toolbox",
  "version": "0.1.0",
  "identifier": "cc.aboom.toolbox",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Aboom Toolbox · 音频工坊",
      "width": 900,
      "height": 740,
      "minWidth": 500,
      "minHeight": 520,
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
